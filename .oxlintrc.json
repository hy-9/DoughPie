{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-explicit-any": "error",
    "typescript/consistent-type-imports": "error"
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"]
}
