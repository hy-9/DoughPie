# ==========================================================================
# Web 端 Vite 环境变量样例（仅开发期生效；生产构建后经 Caddy 同源反代，无需变量）
# 用法：cp apps/web/.env.example apps/web/.env
# ==========================================================================

# 开发期经 Vite 代理到 server:8699（见 vite.config 的 proxy 配置，A 阶段生成）
VITE_API_BASE_URL=/api
VITE_WS_PATH=/socket.io

# 是否显示「使用统一认证登录」按钮（与后端 UC_ENABLED 保持一致）
VITE_UC_ENABLED=false
