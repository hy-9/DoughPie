# ==========================================================================
# 豆排排 环境变量样例（后端 + docker compose 共用）
# 用法：cp .env.example .env 后按需修改；.env 已被 .gitignore 忽略，禁止入库
# 约定对齐 PLAN.md §5.6 / backend.md §9
# ==========================================================================

# ===== 数据库 =====
# compose 注入 postgres 容器使用；本地开发时 DATABASE_URL 直连本机 PG
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://doughpie:CHANGE_ME@localhost:5432/doughpie

# ===== 服务 =====
PORT=8699
NODE_ENV=development
# 自签 JWT HS256 密钥：生产必须强随机（openssl rand -base64 48）
JWT_SECRET=CHANGE_ME_RANDOM
ACCESS_TOKEN_TTL=1800          # access token 寿命（秒），默认 30 分钟
REFRESH_TOKEN_TTL_DAYS=30      # refresh token 寿命（天），滑动 + 轮换
LOGIN_MAX_FAILURES=10          # 连续失败锁定阈值
LOGIN_LOCK_MINUTES=15          # 锁定时长（分钟）

# ===== UC 统一认证集成（默认关闭 = 独立运行，见 backend.md §2）=====
UC_ENABLED=false
UC_BASE_URL=http://localhost:8698
UC_CLIENT_ID=doughpie
UC_CLIENT_SECRET=CHANGE_ME
UC_REDIRECT_URI=http://localhost:5173/auth/callback

# ===== 推送 =====
# web-push VAPID 密钥对（npx web-push generate-vapid-keys 生成，P0 E 阶段需要）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Expo Push 增强凭证（可选，不配置也可发送）
EXPO_ACCESS_TOKEN=

# ===== 附件 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ===== 站点/域名（生产 Caddy 用；本地保持默认） =====
SITE_ADDRESS=localhost
# 生产开启 SSO 时 UC 的公网上游（Caddy /uc/* 反代目标）
# UC_UPSTREAM=https://uc.example.com
